<Project Sdk="Microsoft.NET.Sdk">

  <!-- BasicCameraExample for the original Xbox. Everything console specific comes from the
       RXDK-DotNet props and targets.

       Set RxdkRuntimeDir to the folder holding assemblies/ from rxdk-dotnet-runtime.zip. Left
       unset it uses build-out/ from a checkout of RXDK-DotNet. -->
  <Import Project="../../../../msbuild/Rxdk.Title.props" />

  <PropertyGroup>
    <RootNamespace>BasicCameraExample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <RxdkMgcb Include="Content/Content.mgcb" />
  </ItemGroup>

  <Import Project="../../../../msbuild/Rxdk.Title.targets" />

</Project>
